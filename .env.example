# Copy this file to .env (start.bat / start.sh do it for you) and fill in your keys.
# Everything still works without keys: Bob just uses canned jokes and the browser voice.

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional ElevenLabs voice: https://elevenlabs.io (Profile -> API keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
# One voice per style (optional): ELEVENLABS_VOICE_MEXICANO=..., ELEVENLABS_VOICE_GYM=..., etc.
